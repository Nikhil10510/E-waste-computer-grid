# Local development only. Keep real deployment secrets out of Git.
POSTGRES_PASSWORD=local-development-only
ENROLLMENT_TOKEN=local-enrollment-change-me
# Keep true only while using the existing development launch scripts.
ALLOW_LEGACY_ENROLLMENT=true
GRID_NAME=E-Waste Compute Grid
ADMIN_TOKEN=local-admin-change-me
STORAGE_SECRET=local-storage-signing-change-me
DB_PORT=55432
API_PORT=8080
FRONTEND_PORT=5173
API_BIND_ADDRESS=127.0.0.1
FRONTEND_BIND_ADDRESS=127.0.0.1
# Relative signed URLs work through the dashboard proxy AND direct worker API.
PUBLIC_API_URL=/api
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# To join a second laptop on a trusted LAN, set API_BIND_ADDRESS=0.0.0.0.
# Keep DB bound to loopback; do not open a public router port for this demo.
