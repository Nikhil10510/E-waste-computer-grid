FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY control-plane/package*.json ./
RUN npm ci
COPY control-plane/prisma ./prisma
COPY control-plane/tsconfig.json ./
COPY control-plane/src ./src
COPY control-plane/scripts ./scripts
RUN npm run build
EXPOSE 8080
CMD ["sh", "-c", "npm run db:deploy && exec node dist/index.js"]
