DATABASE_URL=postgresql://ewaste:local-development-only@localhost:55432/ewaste
PORT=8080
ENROLLMENT_TOKEN=local-enrollment-change-me
ALLOW_LEGACY_ENROLLMENT=true
GRID_NAME=E-Waste Compute Grid
ADMIN_TOKEN=local-admin-change-me
STORAGE_SECRET=local-storage-signing-change-me
PUBLIC_API_URL=http://localhost:8080/api
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
STORAGE_DRIVER=local
# STORAGE_DIR=./.storage
# For AWS: use STORAGE_DRIVER=s3, configure the SDK credential chain/IAM role,
# S3_BUCKET, AWS_REGION, and PUBLIC_API_URL reachable from every worker.
# S3_BUCKET=your-bucket
# AWS_REGION=ap-south-1
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true
